<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Weft Studio</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="#">Weft Studio</a>

    <nav class="site-nav" aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero" id="work">
      <p class="eyebrow">Independent design practice</p>

      <h1>Build focused interfaces.</h1>

      <p class="hero-copy">
        We design calm, useful digital products for teams solving
        difficult problems.
      </p>

      <a class="cta" href="#contact">Start a project</a>
    </section>

    <section class="features" id="about" aria-label="Services">
      <article class="feature-card">
        <h2>Product direction</h2>
        <p>
          Clarify the problem, audience, and smallest valuable release.
        </p>
      </article>

      <article class="feature-card">
        <h2>Interface design</h2>
        <p>
          Create accessible flows and reusable visual systems.
        </p>
      </article>

      <article class="feature-card">
        <h2>Delivery support</h2>
        <p>
          Work closely with engineers through implementation.
        </p>
      </article>
    </section>
  </main>

  <footer class="site-footer" id="contact">
    <p>hello@weft.example</p>
  </footer>
</body>
</html>